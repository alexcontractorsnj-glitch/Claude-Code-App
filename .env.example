# BuildFlow server configuration — copy this file to ".env" and fill in values.
# The .env file is gitignored, so secrets never get committed.
#
#   cp .env.example .env   &&   edit .env   &&   npm start
#
# Real shell environment variables always override what's in .env.

# Anthropic API key for the AI Dispatcher (Wave 2). Get one at:
#   https://console.anthropic.com/  → API keys
# Without it, the dispatcher runs on its built-in rule-based fallback brain.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the model the dispatcher reasons with (defaults to a current Claude model).
# DISPATCHER_MODEL=claude-opus-4-8

# Optional: port (defaults to 8000; `npm start` / `node server.mjs <port>` also work).
# PORT=8000
